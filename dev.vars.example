# Copia a .dev.vars (local). En producción son "Secrets" y "Variables" de Cloudflare.
APP_URL=http://localhost:8788
OPENAI_API_KEY=
# Modelos (comprueba los nombres vigentes en https://platform.openai.com/docs/models y cámbialos aquí sin tocar código)
OPENAI_MODEL_FREE=gpt-6.2-astra
OPENAI_MODEL_PAID=gpt-6.2-astra
OPENAI_MODEL_DEEP=gpt-6.2-astra
OPENAI_MODEL_FALLBACK=gpt-6.2-sol
OPENAI_MODEL_LIGHT=gpt-6-luna
OPENAI_IMAGE_MODEL=gpt-image-2.6-sunburst
OPENAI_IMAGE_MODEL_FALLBACK=gpt-image-2.5-sunburst
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_TRANSCRIBE_MODEL_FALLBACK=gpt-4o-mini-transcribe
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_PRO_YEARLY=
# 1 si activas Stripe Tax (cálculo automático de IVA)
STRIPE_AUTOMATIC_TAX=
