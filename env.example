# Frontend (públicas; van al navegador). En Cloudflare Pages: Variables de build.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Proveedores OAuth activados en Supabase, separados por comas: google,apple (vacío = solo email)
VITE_OAUTH_PROVIDERS=
# URL pública de la API si la app móvil (Capacitor) no sirve desde tu dominio. Vacío en web.
VITE_API_BASE=
